                                            speaker: .user,
                                            text: "包装料金はいくらですか？",
                                            translations: [
                                                .indonesian: "포장 비용은 얼마예요?",
                                                .english: "How much is the wrapping fee?",
                                                .japanese: "包装料金はいくらですか？",
                                                .chinese: "包装费多少钱？",
                                                .spanish: "¿Cuánto cuesta envolver?"
