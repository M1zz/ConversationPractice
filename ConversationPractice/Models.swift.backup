                                                    responses: nil
                                                )
                                            ]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
            ],
Scenario(
            id: "es-opening-hours",
            learningLanguage: .spanish,
            category: .tourism,
            icon: "🕐",
            title: [
                .indonesian: "운영 시간 문의",
                .english: "Asking About Opening Hours",
                .japanese: "営業時間を尋ねる",
                .chinese: "询问营业时间",
                .spanish: "Preguntar por horario"
            ],
            description: [
                .indonesian: "운영 시간을 묻는 연습",
                .english: "Practice asking about opening hours",
                .japanese: "営業時間を尋ねる練習",
                .chinese: "练习询问营业时间",
                .spanish: "Practica preguntar por el horario"
            ],
            startingPhrase: "¿Hasta qué hora abre?",
            startingPhraseTranslations: [
                .indonesian: "몇 시까지 열어요?",
                .english: "What time is it open until?",
                .japanese: "何時まで開いていますか？",
                .chinese: "开到几点？",
                .spanish: "¿Hasta qué hora abre?"
            ],
            conversationTree: [
                ConversationNode(
                    id: "es-hours-response1",
                    speaker: .native,
                    text: "Hasta las 5 PM todos los días.",
                    translations: [
                        .indonesian: "매일 오후 5시까지예요.",
                        .english: "Until 5 PM every day.",
                        .japanese: "毎日午後5時までです。",
                        .chinese: "每天到下午5点。",
                        .spanish: "Hasta las 5 PM todos los días."
                    ],
                    responses: [
                        ConversationNode(
                            id: "es-hours-followup1",
                            speaker: .user,
                            text: "¿También abre los domingos?",
                            translations: [
                                .indonesian: "일요일에도 열어요?",
                                .english: "Open on Sundays too?",
                                .japanese: "日曜日も開いていますか？",
                                .chinese: "星期天也开吗？",
                                .spanish: "¿También abre los domingos?"
                            ],
                            responses: [
                                ConversationNode(
                                    id: "es-hours-continue1",
                                    speaker: .native,
                                    text: "Sí, abre todos los días excepto feriados nacionales.",
                                    translations: [
                                        .indonesian: "네, 국경일 빼고 매일 열어요.",
                                        .english: "Yes, open every day except national holidays.",
                                        .japanese: "はい、祝日以外は毎日開いています。",
                                        .chinese: "是的，除了国定假日每天都开。",
                                        .spanish: "Sí, abre todos los días excepto feriados nacionales."
                                    ],
                                    responses: [
                                        ConversationNode(
                                            id: "es-hours-followup2",
                                            speaker: .user,
                                            text: "¡Genial! Gracias por la información.",
                                            translations: [
                                                .indonesian: "좋아요! 정보 감사합니다.",
                                                .english: "Great! Thank you for the information.",
                                                .japanese: "良かった！情報ありがとうございます。",
                                                .chinese: "太好了！谢谢信息。",
                                                .spanish: "¡Genial! Gracias por la información."
                                            ],
                                            responses: [
                                                ConversationNode(
                                                    id: "es-hours-end1",
                                                    speaker: .native,
                                                    text: "De nada. ¡Que disfrute su visita!",
                                                    translations: [
                                                        .indonesian: "천만에요. 즐거운 관람 되세요!",
                                                        .english: "You're welcome. Enjoy your visit!",
                                                        .japanese: "どういたしまして。良い見学を！",
                                                        .chinese: "不客气。祝您参观愉快！",
                                                        .spanish: "De nada. ¡Que disfrute su visita!"
                                                    ],
                                                    responses: nil
                                                )
                                            ]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
            ],
Scenario(
            id: "es-guided-tour",
            learningLanguage: .spanish,
            category: .tourism,
            icon: "👨‍🏫",
            title: [
                .indonesian: "가이드 투어",
                .english: "Guided Tour",
                .japanese: "ガイドツアー",
                .chinese: "导游服务",
                .spanish: "Tour guiado"
            ],
            description: [
                .indonesian: "가이드 투어를 신청하는 연습",
                .english: "Practice requesting a guided tour",
                .japanese: "ガイドツアーを申し込む練習",
                .chinese: "练习申请导游服务",
                .spanish: "Practica solicitar un tour guiado"
            ],
            startingPhrase: "¿Hay guía turístico que hable inglés?",
            startingPhraseTranslations: [
                .indonesian: "영어 가이드 있나요?",
                .english: "Is there an English-speaking tour guide?",
                .japanese: "英語を話すガイドはいますか？",
                .chinese: "有说英语的导游吗？",
                .spanish: "¿Hay guía turístico que hable inglés?"
            ],
            conversationTree: [
                ConversationNode(
                    id: "es-guide-response1",
                    speaker: .native,
                    text: "Sí. Los tours comienzan a las 10 AM.",
                    translations: [
                        .indonesian: "있어요. 투어는 오전 10시에 시작해요.",
                        .english: "Yes. Tours start at 10 AM.",
                        .japanese: "います。ツアーは午前10時に始まります。",
                        .chinese: "有的。导览从早上10点开始。",
                        .spanish: "Sí. Los tours comienzan a las 10 AM."
                    ],
                    responses: [
                        ConversationNode(
                            id: "es-guide-followup1",
                            speaker: .user,
                            text: "¿Cuánto cuesta?",
                            translations: [
                                .indonesian: "비용이 얼마예요?",
                                .english: "How much does it cost?",
                                .japanese: "費用はいくらですか？",
                                .chinese: "费用是多少？",
                                .spanish: "¿Cuánto cuesta?"
                            ],
                            responses: [
                                ConversationNode(
                                    id: "es-guide-continue1",
                                    speaker: .native,
                                    text: "200 mil por persona para un tour de 2 horas.",
                                    translations: [
                                        .indonesian: "2시간 투어에 1인당 20만 루피아예요.",
                                        .english: "200 thousand per person for a 2-hour tour.",
                                        .japanese: "2時間ツアーで一人20万ルピアです。",
                                        .chinese: "2小时导览每人20万。",
                                        .spanish: "200 mil por persona para un tour de 2 horas."
                                    ],
                                    responses: [
                                        ConversationNode(
                                            id: "es-guide-followup2",
                                            speaker: .user,
                                            text: "Bueno, quiero unirme al tour de las 10. ¿Dónde me registro?",
                                            translations: [
                                                .indonesian: "알겠어요, 10시 투어 참가하고 싶어요. 어디서 신청하나요?",
