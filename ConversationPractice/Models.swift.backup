                            speaker: .user,
                            text: "どうもありがとうございます！",
                            translations: [
                                .indonesian: "정말 감사합니다!",
                                .english: "Thank you very much!",
                                .japanese: "どうもありがとうございます！",
                                .chinese: "非常感谢！",
