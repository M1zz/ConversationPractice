            ],
Scenario(
            id: "zh-hotel-checkin",
            learningLanguage: .chinese,
            category: .hotel,
            icon: "🏨",
            title: [
                .indonesian: "호텔 체크인",
                .english: "Hotel Check-in",
                .japanese: "ホテルチェックイン",
                .chinese: "酒店入住",
