                                                .japanese: "これがレシートです。Lサイズはありますか？",
                                                .chinese: "这是收据。有L码吗？",
                                                .spanish: "Aquí está el recibo. ¿Tienen talla L?"
                                            ],
                                            responses: [
                                                ConversationNode(
