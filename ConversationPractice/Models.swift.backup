                .spanish: "¿Cuál es la contraseña del WiFi?"
            ],
            conversationTree: [
                ConversationNode(
                    id: "ja-wifi-response1",
                    speaker: .native,
                    text: "ちょっと待って、書きますね。これです。",
                    translations: [
                        .indonesian: "잠깐만요, 써드릴게요. 여기요.",
                        .english: "One moment, I'll write it down. Here it is.",
