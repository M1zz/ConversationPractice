                .english: "Practice asking about vegetarian menu",
                .japanese: "ベジタリアンメニューを尋ねる練習",
                .chinese: "练习询问素食菜单",
                .spanish: "Practica preguntar por el menú vegetariano"
            ],
            startingPhrase: "¿Tienen menú vegetariano?",
            startingPhraseTranslations: [
                .indonesian: "채식 메뉴 있나요?",
                .english: "Do you have vegetarian menu?",
                .japanese: "ベジタリアンメニューはありますか？",
                .chinese: "有素食菜单吗？",
                .spanish: "¿Tienen menú vegetariano?"
            ],
            conversationTree: [
                ConversationNode(
                    id: "es-vegetarian-response1",
                    speaker: .native,
                    text: "Sí. ¿Quiere algo sin nada de carne?",
                    translations: [
                        .indonesian: "있어요. 고기가 전혀 안 들어간 걸로 드릴까요?",
                        .english: "Yes. Would you like something with no meat at all?",
                        .japanese: "あります。肉が全く入っていないものがいいですか？",
                        .chinese: "有的。您要完全不含肉的吗？",
                        .spanish: "Sí. ¿Quiere algo sin nada de carne?"
                    ],
                    responses: [
                        ConversationNode(
                            id: "es-vegetarian-followup1",
                            speaker: .user,
                            text: "Sí, soy vegetariano.",
                            translations: [
                                .indonesian: "네, 저 채식주의자예요.",
                                .english: "Yes, I'm vegetarian.",
                                .japanese: "はい、ベジタリアンです。",
                                .chinese: "是的，我吃素。",
                                .spanish: "Sí, soy vegetariano."
                            ],
                            responses: [
                                ConversationNode(
                                    id: "es-vegetarian-continue1",
                                    speaker: .native,
                                    text: "Bien, recomiendo gado-gado o cap cay.",
                                    translations: [
                                        .indonesian: "네, 가도가도나 잡채 추천드려요.",
                                        .english: "Okay, I recommend gado-gado or cap cay.",
                                        .japanese: "わかりました、ガドガドかチャプチャイをおすすめします。",
                                        .chinese: "好的，我推荐加多加多或炒杂菜。",
                                        .spanish: "Bien, recomiendo gado-gado o cap cay."
                                    ],
                                    responses: [
                                        ConversationNode(
                                            id: "es-vegetarian-followup2",
                                            speaker: .user,
                                            text: "Gado-gado suena bien. Pediré eso.",
                                            translations: [
                                                .indonesian: "가도가도 맛있어 보여요. 그걸로 주세요.",
                                                .english: "Gado-gado sounds good. I'll order that.",
                                                .japanese: "ガドガドが美味しそうです。それを注文します。",
                                                .chinese: "加多加多听起来不错。我点那个。",
                                                .spanish: "Gado-gado suena bien. Pediré eso."
                                            ],
                                            responses: [
                                                ConversationNode(
                                                    id: "es-vegetarian-end1",
                                                    speaker: .native,
                                                    text: "¡Buena elección! Lo haré ahora.",
                                                    translations: [
                                                        .indonesian: "좋은 선택이에요! 지금 만들어 드릴게요.",
