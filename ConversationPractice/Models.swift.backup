                    responses: [
                        ConversationNode(
                            id: "es-checkout-followup1",
                            speaker: .user,
                            text: "305. ¿Hay cargos adicionales?",
                            translations: [
                                .indonesian: "305호요. 추가 요금이 있나요?",
                                .english: "305. Are there any additional charges?",
                                .japanese: "305号です。追加料金はありますか？",
