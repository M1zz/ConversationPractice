                .english: "What time is breakfast?",
                .japanese: "朝食は何時ですか？",
                .chinese: "早餐几点？",
                .spanish: "¿A qué hora es el desayuno?"
            ],
            conversationTree: [
                ConversationNode(
                    id: "zh-breakfast-response1",
                    speaker: .native,
                    text: "早上6点到10点。",
