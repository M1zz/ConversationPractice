                                .indonesian: "더 빠른 걸로 가주세요.",
                                .english: "Whichever is faster.",
                                .japanese: "早い方でお願いします。",
                                .chinese: "走快一点的就好。",
                                .spanish: "El que sea más rápido."
                            ],
                            responses: [
                                ConversationNode(
                                    id: "es-destination-continue1",
