                .english: "Practice asking for the bill",
                .japanese: "会計をお願いする練習",
                .chinese: "练习要账单",
                .spanish: "Practica pedir la cuenta"
            ],
            startingPhrase: "お会計お願いします。",
            startingPhraseTranslations: [
                .indonesian: "계산서 주세요.",
                .english: "Can I have the bill please?",
                .japanese: "お会計お願いします。",
                .chinese: "请给我账单。",
                .spanish: "La cuenta por favor."
            ],
            conversationTree: [
                ConversationNode(
