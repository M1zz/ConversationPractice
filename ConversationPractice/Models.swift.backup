                                    responses: [
                                        ConversationNode(
                                            id: "ja-pharmacy-followup2",
                                            speaker: .user,
                                            text: "どうもありがとうございます！",
                                            translations: [
                                                .indonesian: "정말 감사합니다!",
                                                .english: "Thank you so much!",
                                                .japanese: "どうもありがとうございます！",
                                                .chinese: "非常感谢！",
                                                .spanish: "¡Muchas gracias!"
                                            ],
                                            responses: [
                                                ConversationNode(
                                                    id: "ja-pharmacy-end1",
                                                    speaker: .native,
                                                    text: "どういたしまして。お大事に！",
                                                    translations: [
                                                        .indonesian: "천만에요. 빨리 나으세요!",
                                                        .english: "You're welcome. Get well soon!",
                                                        .japanese: "どういたしまして。お大事に！",
