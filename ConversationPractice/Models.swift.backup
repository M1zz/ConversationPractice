                .chinese: "练习买交通票",
                .spanish: "Practica comprar boleto de transporte"
            ],
            startingPhrase: "我想买到万隆的票。",
            startingPhraseTranslations: [
                .indonesian: "반둥까지 가는 표를 사고 싶어요.",
                .english: "I'd like to buy a ticket to Bandung.",
                .japanese: "バンドンまでのチケットを買いたいです。",
                .chinese: "我想买到万隆的票。",
                .spanish: "Quiero comprar un boleto a Bandung."
            ],
            conversationTree: [
                ConversationNode(
                    id: "zh-ticket-response1",
                    speaker: .native,
                    text: "几点出发？",
                    translations: [
                        .indonesian: "몇 시 출발이세요?",
                        .english: "What time departure?",
                        .japanese: "出発時刻は何時ですか？",
                        .chinese: "几点出发？",
                        .spanish: "¿A qué hora sale?"
                    ],
                    responses: [
                        ConversationNode(
                            id: "zh-ticket-followup1",
                            speaker: .user,
                            text: "早上的，9点左右。",
                            translations: [
                                .indonesian: "아침이요, 9시쯤이요.",
                                .english: "Morning, around 9 o'clock.",
                                .japanese: "朝です、9時頃です。",
                                .chinese: "早上的，9点左右。",
                                .spanish: "De mañana, alrededor de las 9."
                            ],
                            responses: [
                                ConversationNode(
