                                    responses: [
                                        ConversationNode(
                                            id: "ja-entrance-followup2",
                                            speaker: .user,
                                            text: "ありがとうございます。閉館は何時ですか？",
                                            translations: [
                                                .indonesian: "감사합니다. 몇 시에 닫아요?",
                                                .english: "Thank you. What time does it close?",
                                                .japanese: "ありがとうございます。閉館は何時ですか？",
                                                .chinese: "谢谢。几点关门？",
                                                .spanish: "Gracias. ¿A qué hora cierra?"
