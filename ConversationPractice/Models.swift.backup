                                                    speaker: .native,
                                                    text: "有的。我给您拿L码的。",
                                                    translations: [
                                                        .indonesian: "있어요. L 사이즈 가져올게요.",
                                                        .english: "Yes. Let me get size L for you.",
                                                        .japanese: "あります。Lサイズを取ってきますね。",
                                                        .chinese: "有的。我给您拿L码的。",
                                                        .spanish: "Sí. Le traigo la talla L."
                                                    ],
                                                    responses: nil
                                                )
                                            ]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
            ],
