                                                .chinese: "非常感谢！",
                                                .spanish: "¡Muchas gracias!"
                                            ],
                                            responses: [
                                                ConversationNode(
                                                    id: "es-taxi-end1",
                                                    speaker: .native,
                                                    text: "De nada. Espere al frente.",
                                                    translations: [
