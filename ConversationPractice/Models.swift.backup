                .japanese: "割引をお願いする練習",
                .chinese: "练习询问折扣",
                .spanish: "Practica pedir descuento"
            ],
            startingPhrase: "割引はありますか？",
            startingPhraseTranslations: [
                .indonesian: "할인 있어요?",
                .english: "Is there a discount?",
