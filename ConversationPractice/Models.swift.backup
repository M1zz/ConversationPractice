                            text: "Sí, aquí está.",
                            translations: [
                                .indonesian: "네, 여기요.",
                                .english: "Yes, here it is.",
                                .japanese: "はい、どうぞ。",
                                .chinese: "好的，在这里。",
                                .spanish: "Sí, aquí está."
                            ],
                            responses: [
                                ConversationNode(
                                    id: "es-hotelcheckin-continue1",
                                    speaker: .native,
                                    text: "Gracias. Aquí está la llave de la habitación 305. Desayuno desde las 7 AM.",
                                    translations: [
                                        .indonesian: "감사합니다. 여기 305호 키입니다. 조식은 아침 7시부터예요.",
                                        .english: "Thank you. Here's the key to room 305. Breakfast from 7 AM.",
                                        .japanese: "ありがとうございます。305号室の鍵です。朝食は朝7時からです。",
                                        .chinese: "谢谢。这是305号房间的钥匙。早餐从早上7点开始。",
