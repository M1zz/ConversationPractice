                        .indonesian: "왜 반품하시는지 여쭤봐도 될까요?",
                        .english: "May I know why you want to return it?",
                        .japanese: "返品理由をお聞きしてもよろしいですか？",
                        .chinese: "可以问一下为什么要退货吗？",
                        .spanish: "¿Puedo saber por qué quiere devolverlo?"
                    ],
                    responses: [
                        ConversationNode(
