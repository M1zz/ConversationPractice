                                            text: "¿Puedo pagar con tarjeta de crédito?",
                                            translations: [
                                                .indonesian: "신용카드로 결제할 수 있나요?",
                                                .english: "Can I pay with credit card?",
                                                .japanese: "クレジットカードで支払えますか？",
                                                .chinese: "可以用信用卡支付吗？",
                                                .spanish: "¿Puedo pagar con tarjeta de crédito?"
