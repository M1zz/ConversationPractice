                .english: "Practice asking for a refund",
                .japanese: "返金をお願いする練習",
                .chinese: "练习要求退款",
                .spanish: "Practica solicitar reembolso"
            ],
            startingPhrase: "Quiero devolver este artículo.",
            startingPhraseTranslations: [
