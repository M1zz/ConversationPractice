                                            speaker: .user,
                                            text: "Apakah WiFi-nya kencang?",
                                            translations: [
                                                .korean: "와이파이 빠른가요?",
                                                .english: "Is the WiFi fast?",
                                                .japanese: "WiFiは速いですか？",
                                                .chinese: "WiFi快吗？",
                                                .spanish: "¿El WiFi es rápido?"
                                            ],
                                            responses: [
                                                ConversationNode(
                                                    id: "id-wifi-end1",
                                                    speaker: .native,
                                                    text: "Ya, lumayan kencang. Bisa untuk streaming juga.",
                                                    translations: [
                                                        .korean: "네, 꽤 빨라요. 스트리밍도 할 수 있어요.",
