                        .spanish: "¡El Templo de Borobudur es genial! Debe ir allí."
                    ],
                    responses: [
                        ConversationNode(
                            id: "es-placerec-followup1",
                            speaker: .user,
                            text: "¿Está lejos de aquí?",
                            translations: [
                                .indonesian: "여기서 멀어요?",
                                .english: "Is it far from here?",
                                .japanese: "ここから遠いですか？",
                                .chinese: "从这里远吗？",
                                .spanish: "¿Está lejos de aquí?"
                            ],
                            responses: [
