                                            speaker: .user,
                                            text: "Thank you. Where is the breakfast room?",
                                            translations: [
                                                .indonesian: "감사합니다. 조식당이 어디에 있나요?",
                                                .english: "Thank you. Where is the breakfast room?",
                                                .japanese: "ありがとうございます。朝食ルームはどこですか？",
                                                .chinese: "谢谢。早餐室在哪里？",
                                                .spanish: "Gracias. ¿Dónde está el comedor del desayuno?"
