                    responses: [
                        ConversationNode(
                            id: "zh-refund-followup1",
                            speaker: .user,
                            text: "尺码太小了。",
                            translations: [
                                .indonesian: "사이즈가 작아요.",
                                .english: "The size is too small.",
                                .japanese: "サイズが小さすぎます。",
                                .chinese: "尺码太小了。",
                                .spanish: "La talla es muy pequeña."
