                            responses: [
                                ConversationNode(
                                    id: "ja-entrance-continue1",
                                    speaker: .native,
                                    text: "合計10万ルピアです。チケットです。",
                                    translations: [
                                        .indonesian: "총 10만 루피아예요. 여기 티켓이요.",
                                        .english: "Total 100 thousand. Here are your tickets.",
                                        .japanese: "合計10万ルピアです。チケットです。",
                                        .chinese: "总共10万。这是您的票。",
                                        .spanish: "Total 100 mil. Aquí están sus entradas."
