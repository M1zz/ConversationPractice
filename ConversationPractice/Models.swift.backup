                            speaker: .user,
                            text: "Me gustaría sentarme junto a la ventana.",
                            translations: [
                                .indonesian: "창문 쪽에 앉고 싶어요.",
                                .english: "I'd like to sit by the window.",
                                .japanese: "窓側に座りたいです。",
                                .chinese: "我想坐在靠窗的位置。",
                                .spanish: "Me gustaría sentarme junto a la ventana."
