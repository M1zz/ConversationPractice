                            responses: [
                                ConversationNode(
                                    id: "ja-giftwrap-continue1",
                                    speaker: .native,
                                    text: "わかりました、少々お待ちください、包装しますね。",
                                    translations: [
                                        .indonesian: "네, 잠시만요, 포장해드릴게요.",
                                        .english: "Okay, one moment, I'll wrap it for you.",
                                        .japanese: "わかりました、少々お待ちください、包装しますね。",
                                        .chinese: "好的，稍等，我帮您包装。",
                                        .spanish: "Bien, un momento, lo envuelvo."
