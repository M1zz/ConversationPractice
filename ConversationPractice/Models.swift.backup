                            id: "ko-seat-followup1",
                            speaker: .user,
                            text: "창문 쪽에 앉고 싶어요.",
                            translations: [
                                .indonesian: "창문 쪽에 앉고 싶어요.",
                                .english: "I'd like to sit by the window.",
                                .japanese: "窓側に座りたいです。",
