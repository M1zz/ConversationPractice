                                    text: "是的，已经打开了。",
                                    translations: [
                                        .indonesian: "네, 이미 켰어요.",
                                        .english: "Yes, I already turned it on.",
                                        .japanese: "はい、もう付けました。",
                                        .chinese: "是的，已经打开了。",
