            startingPhraseTranslations: [
                .indonesian: "실례합니다, 수하물 찾는 곳이 어디에요?",
                .english: "Excuse me, where is baggage claim?",
                .japanese: "すみません、手荷物受取所はどこですか？",
                .chinese: "请问，行李提取处在哪里？",
                .spanish: "Disculpe, ¿dónde está la recogida de equipaje?"
