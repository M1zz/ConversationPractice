Scenario(
            id: "ko-ask-price",
            learningLanguage: .korean,
            category: .shopping,
            icon: "💵",
            title: [
                .indonesian: "가격 문의",
                .english: "Asking Price",
                .japanese: "価格を尋ねる",
                .chinese: "询问价格",
