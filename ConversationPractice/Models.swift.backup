                            speaker: .user,
                            text: "走路大概几分钟？",
                            translations: [
                                .indonesian: "걸어서 몇 분 정도 걸려요?",
                                .english: "About how many minutes walking?",
                                .japanese: "歩いて何分くらいですか？",
                                .chinese: "走路大概几分钟？",
                                .spanish: "¿Cuántos minutos caminando?"
