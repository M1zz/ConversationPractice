            conversationTree: [
                ConversationNode(
                    id: "ja-photo-response1",
                    speaker: .native,
                    text: "オッケー、準備して。いち、に、さん！",
                    translations: [
                        .indonesian: "네, 준비하세요. 하나, 둘, 셋!",
