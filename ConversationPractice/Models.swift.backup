                            speaker: .user,
                            text: "La talla es muy pequeña.",
                            translations: [
                                .indonesian: "사이즈가 작아요.",
                                .english: "The size is too small.",
                                .japanese: "サイズが小さすぎます。",
                                .chinese: "尺码太小了。",
                                .spanish: "La talla es muy pequeña."
