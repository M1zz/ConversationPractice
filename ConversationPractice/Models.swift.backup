                                            responses: [
                                                ConversationNode(
                                                    id: "id-reservation-end1",
                                                    speaker: .native,
                                                    text: "Ya, tolong berikan nomor telepon Anda. Reservasi atas nama Kim jam 7 malam ya.",
                                                    translations: [
                                                        .korean: "네, 전화번호 알려주세요. 김님 이름으로 저녁 7시 예약이네요.",
                                                        .english: "Yes, please provide your phone number. Reservation under Kim at 7 PM.",
                                                        .japanese: "はい、電話番号をお願いします。キム様で午後7時のご予約ですね。",
