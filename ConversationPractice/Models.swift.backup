                                        .english: "A little spicy, but really delicious!",
                                        .japanese: "少し辛いですが、とてもおいしいですよ！",
                                        .chinese: "有点辣，但是很好吃！",
                                        .spanish: "Un poco picante, ¡pero muy rico!"
                                    ],
                                    responses: [
                                        ConversationNode(
                                            id: "en-recommend-followup2",
