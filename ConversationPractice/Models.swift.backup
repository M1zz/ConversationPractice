                                    id: "ja-pharmacy-continue1",
                                    speaker: .native,
                                    text: "はい、夜10時まで開いています。",
                                    translations: [
                                        .indonesian: "네, 밤 10시까지 열어요.",
                                        .english: "Yes, open until 10 PM.",
                                        .japanese: "はい、夜10時まで開いています。",
