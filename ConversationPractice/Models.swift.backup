                                    text: "Gracias. ¿Efectivo o tarjeta?",
                                    translations: [
                                        .indonesian: "감사합니다. 현금으로 하시겠어요, 카드로 하시겠어요?",
                                        .english: "Thank you. Cash or card?",
                                        .japanese: "ありがとうございます。現金かカードですか？",
                                        .chinese: "谢谢。现金还是卡？",
                                        .spanish: "Gracias. ¿Efectivo o tarjeta?"
                                    ],
                                    responses: [
                                        ConversationNode(
                                            id: "es-discount-followup2",
                                            speaker: .user,
                                            text: "Con tarjeta. ¿Aceptan Visa?",
                                            translations: [
                                                .indonesian: "카드로요. 비자 되나요?",
                                                .english: "By card. Do you accept Visa?",
                                                .japanese: "カードで。Visaは使えますか？",
                                                .chinese: "用卡。可以用Visa吗？",
                                                .spanish: "Con tarjeta. ¿Aceptan Visa?"
                                            ],
                                            responses: [
                                                ConversationNode(
                                                    id: "es-discount-end1",
                                                    speaker: .native,
                                                    text: "Sí. Aquí está la máquina, toque por favor.",
                                                    translations: [
                                                        .indonesian: "됩니다. 여기 기계예요, 터치하세요.",
                                                        .english: "Yes. Here's the machine, please tap.",
                                                        .japanese: "使えます。こちらが機械です、タップしてください。",
                                                        .chinese: "可以。这是机器，请刷卡。",
                                                        .spanish: "Sí. Aquí está la máquina, toque por favor."
                                                    ],
                                                    responses: nil
                                                )
                                            ]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
            ],
