                                                .indonesian: "지금 옮겨도 될까요?",
                                                .english: "Can I move now?",
                                                .japanese: "今移動してもいいですか？",
                                                .chinese: "我现在可以换吗？",
                                                .spanish: "¿Puedo moverme ahora?"
                                            ],
                                            responses: [
                                                ConversationNode(
                                                    id: "zh-seat-end1",
                                                    speaker: .native,
                                                    text: "当然可以，请在安全带指示灯熄灭后移动。",
                                                    translations: [
