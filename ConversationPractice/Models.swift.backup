                                .chinese: "在哪里？",
                                .spanish: "¿Dónde es?"
                            ],
                            responses: [
                                ConversationNode(
                                    id: "zh-breakfast-continue1",
                                    speaker: .native,
                                    text: "在一楼，大厅旁边。",
                                    translations: [
                                        .indonesian: "1층이요, 로비 옆이에요.",
                                        .english: "On the first floor, next to the lobby.",
                                        .japanese: "1階です、ロビーの隣です。",
