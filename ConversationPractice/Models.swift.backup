            ],
Scenario(
            id: "ko-weather-chat",
            learningLanguage: .korean,
            category: .casual,
            icon: "🌤️",
            title: [
                .indonesian: "날씨 대화",
                .english: "Weather Chat",
                .japanese: "天気の話",
