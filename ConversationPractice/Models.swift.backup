                .english: "Practice changing airplane seats",
                .japanese: "飛行機の座席を変える練習",
                .chinese: "练习换飞机座位",
                .spanish: "Practica cambiar de asiento en el avión"
            ],
            startingPhrase: "Disculpe, ¿puedo cambiar de asiento?",
            startingPhraseTranslations: [
