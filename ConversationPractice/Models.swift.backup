                                                    speaker: .native,
                                                    text: "無料ですよ、含まれています。",
                                                    translations: [
                                                        .indonesian: "무료예요, 포함되어 있어요.",
                                                        .english: "It's free, already included.",
                                                        .japanese: "無料ですよ、含まれています。",
                                                        .chinese: "免费的，已经包括了。",
                                                        .spanish: "Es gratis, ya está incluido."
                                                    ],
                                                    responses: nil
                                                )
                                            ]
                                        )
                                    ]
                                )
                            ]
                        )
                    ]
                )
            ],
Scenario(
            id: "ja-buy-entrance-ticket",
            learningLanguage: .japanese,
            category: .tourism,
            icon: "🎟️",
            title: [
                .indonesian: "입장권 구매",
                .english: "Buying Entrance Ticket",
