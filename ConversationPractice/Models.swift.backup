            ],
            conversationTree: [
                ConversationNode(
                    id: "es-destination-response1",
                    speaker: .native,
                    text: "Bien. ¿Por autopista de peaje o carretera normal?",
                    translations: [
                        .indonesian: "네. 고속도로로 갈까요, 일반 도로로 갈까요?",
                        .english: "Okay. Via toll road or regular road?",
                        .japanese: "わかりました。高速道路か一般道路、どちらがいいですか？",
