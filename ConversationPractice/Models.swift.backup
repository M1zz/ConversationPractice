                .japanese: "タオルを追加でもらえますか？",
                .chinese: "可以再要一些毛巾吗？",
                .spanish: "¿Puedo tener toallas extra?"
            ],
            conversationTree: [
                ConversationNode(
                    id: "es-towel-response1",
                    speaker: .native,
                    text: "Claro. ¿Cuántas necesita?",
                    translations: [
