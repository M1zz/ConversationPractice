                                .english: "Thank you very much!",
                                .japanese: "どうもありがとうございます！",
                                .chinese: "非常感谢！",
                                .spanish: "¡Muchas gracias!"
                            ],
                            responses: [
                                ConversationNode(
                                    id: "en-baggage-continue1",
                                    speaker: .native,
                                    text: "You're welcome, welcome!",
