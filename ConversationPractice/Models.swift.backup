                .japanese: "私は韓国から来ました。",
                .chinese: "我来自韩国。",
                .spanish: "Soy de Corea."
            ],
            conversationTree: [
                ConversationNode(
                    id: "es-from-response1",
                    speaker: .native,
                    text: "¡Wow, Corea! ¿Te gusta el K-pop?",
                    translations: [
                        .indonesian: "와, 한국이요! K-pop 좋아하세요?",
                        .english: "Wow, Korea! Do you like K-pop?",
                        .japanese: "わあ、韓国！K-popは好きですか？",
                        .chinese: "哇，韩国！喜欢K-pop吗？",
                        .spanish: "¡Wow, Corea! ¿Te gusta el K-pop?"
                    ],
                    responses: [
                        ConversationNode(
