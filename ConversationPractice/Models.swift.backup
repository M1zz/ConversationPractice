            startingPhrase: "这附近有好吃的餐馆吗？",
            startingPhraseTranslations: [
                .indonesian: "이 근처에 맛있는 식당 있어요?",
                .english: "Are there any good eateries around here?",
                .japanese: "この辺においしい食堂はありますか？",
