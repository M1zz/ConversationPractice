                                                    speaker: .native,
                                                    text: "En el mostrador de información, al lado de la entrada.",
                                                    translations: [
                                                        .indonesian: "안내 창구에서요, 입구 옆에 있어요.",
                                                        .english: "At the information counter, next to the entrance.",
                                                        .japanese: "案内カウンターで、入口の隣です。",
                                                        .chinese: "在咨询台，入口旁边。",
                                                        .spanish: "En el mostrador de información, al lado de la entrada."
                                                    ],
                                                    responses: nil
                                                )
