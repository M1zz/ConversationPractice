Scenario(
            id: "es-table-reservation",
            learningLanguage: .spanish,
            category: .restaurant,
            icon: "📅",
            title: [
                .indonesian: "테이블 예약",
                .english: "Table Reservation",
                .japanese: "テーブル予約",
